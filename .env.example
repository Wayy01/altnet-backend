# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=ultra-data
DB_SSLMODE=disable

# Ultra B2B API Configuration
ULTRA_API_URL=https://portal.it-ultra.com/b2b/ws/b2b.1cws
ULTRA_API_USERNAME=your_username_here
ULTRA_API_PASSWORD=your_password_here

# Ultra API Timeouts & Retry
ULTRA_API_TIMEOUT=60s
ULTRA_API_REQUEST_INTERVAL=1s
ULTRA_API_MAX_RETRIES=3
ULTRA_API_POLL_INTERVAL=5s
ULTRA_API_POLL_TIMEOUT=5m

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# FTP Configuration
FTP_HOST=your_ftp_host:21
FTP_USER=your_ftp_user
FTP_PASSWORD=your_ftp_password
FTP_JSON_PATH=Import/goods_update.json
FTP_IMAGES_PATH=WebFile/
FTP_TIMEOUT=60s

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Server
SERVER_PORT=8080

# LibreTranslate Configuration
LIBRETRANSLATE_URL=http://localhost:5000
ENABLE_SCHEDULER=true

# Ollama AI Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30s

# Meilisearch Configuration
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key_here
MEILISEARCH_INDEX_NAME=products

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h
